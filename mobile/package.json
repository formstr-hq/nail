{
  "name": "mailstr-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Capacitor Android wrapper for Mailstr (landing @ / + client @ /mails/).",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "cap sync android",
    "build": "npm run build:web && npm run sync",
    "open": "cap open android",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "~5.7"
  }
}
