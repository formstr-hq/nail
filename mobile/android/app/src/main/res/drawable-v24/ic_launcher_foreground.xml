<?xml version="1.0" encoding="utf-8"?>
<!-- Mail by Form* app mark — adaptive-icon foreground (API 26+).

     Design: a white envelope (the universal 'mail' gesture) with one bold red
     wax seal sitting on the lower-right of the envelope flap, on a black
     background provided by @drawable/ic_launcher_background.

     Why this and not the previous mark: the old design had a tiny red spark
     inside a white disc that ate the envelope's top-right corner, which read
     as 'clipped' and let the white flap and the white disc fight each other
     for the eye. A single, generously-sized red circle on the envelope flap
     gives the icon one clear focal point and lets the eye read 'envelope'
     first, then the red accent — 'calm paper, loud ink' at icon scale.

     Geometry matches scripts/render-app-icon.py (the PNG-fallback source of
     truth), so adaptive and raster render identically. Drawn at the native
     108×108 viewport with all art inside the central safe zone (y=21..87), so
     no launcher mask ever clips the mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Envelope body — white, with rounded corners. Centered vertically
         inside the safe zone. 64 wide × 48 tall. -->
    <path
        android:fillColor="#F4F4F3"
        android:pathData="M28,30 H80 A6,6 0 0 1 86,36 V72 A6,6 0 0 1 80,78 H28 A6,6 0 0 1 22,72 V36 A6,6 0 0 1 28,30 Z" />

    <!-- Envelope flap — black V stroke (so it shows against the white body).
         From the top corners down to the bottom-center. -->
    <path
        android:strokeColor="#0B0B0C"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M22,36 L54,64 L86,36" />

    <!-- Wax seal — single bold red circle, on the lower-right of the
         envelope flap where it visually anchors the mark. -->
    <path
        android:fillColor="#E5484D"
        android:pathData="M68,60 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
</vector>
