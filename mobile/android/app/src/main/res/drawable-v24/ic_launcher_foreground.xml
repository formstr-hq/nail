<?xml version="1.0" encoding="utf-8"?>
<!-- Mail by Form* brand mark (mirrors landing/public/favicon.svg): a black
     envelope with a paper flap and a paper disc + red spark.
     The 64-unit artwork is scaled 1.125x and offset by 18 so it sits inside
     the adaptive-icon safe zone (central 72 of the 108 canvas). Lives in
     drawable-v24 because adaptive icons (API 26+) resolve @drawable to the
     highest qualifier — a plain drawable/ copy would be shadowed by this one. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.125"
        android:scaleY="1.125"
        android:translateX="18"
        android:translateY="18">
        <!-- envelope body -->
        <path
            android:pathData="M12,12 H52 A8,8 0 0 1 60,20 V44 A8,8 0 0 1 52,52 H12 A8,8 0 0 1 4,44 V20 A8,8 0 0 1 12,12 Z"
            android:fillColor="#FF0B0B0C"/>
        <!-- flap -->
        <path
            android:pathData="M8,18 L32,38 L56,18"
            android:strokeColor="#F4F4F3"
            android:strokeWidth="4.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"/>
        <!-- disc -->
        <path
            android:pathData="M40,14 A10,10 0 1 1 60,14 A10,10 0 1 1 40,14 Z"
            android:fillColor="#F4F4F3"/>
        <!-- spark -->
        <path
            android:pathData="M50,8.5 L50,19.5 M45.2,11.25 L54.8,16.75 M45.2,16.75 L54.8,11.25"
            android:strokeColor="#E5484D"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"/>
    </group>
</vector>
