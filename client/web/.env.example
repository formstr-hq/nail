# Host directory the built site is copied into (served by the external nginx)
WEB_DIST_PATH=/var/www/mailstr

# formstr-backend origin production builds call directly
VITE_API_BASE_URL=https://api.formstr.app
VITE_WS_BASE_URL=wss://api.formstr.app

# Dev only: origin Vite's /api and /ws proxies forward to
# (unset = https://api.formstr.app; use http://localhost:5000 for a local backend)
#VITE_API_PROXY_TARGET=http://localhost:5000

# Origin the mail app signs into NIP-98 `u` tags (must match what the backend
# sees; leave unset for the production default)
#VITE_API_CANONICAL_BASE_URL=https://api.formstr.app

# Address domain and mail-UI location
VITE_MAIL_DOMAIN=mailstr.app
VITE_MAILS_URL=/mails