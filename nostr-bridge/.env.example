# nostr-bridge environment. Copy to `.env` (and into the mailcow deployment's
# env file, where the container is defined) and fill in. Values shown are
# examples, never real secrets — this file is committed.
#
# Required
# --------
# Bridge signing key (nsec1… or 64 hex chars). The bridge publishes its own
# kind-10050/kind-0 with this key and the backend registers its npub as the
# `_smtp@<domain>` NIP-05 record (bridge identity + outbound discovery).
NOSTR_BRIDGE_NSEC=

# Domains this deployment accepts mail for and relays outbound From. The
# first entry is the bridge's advertised identity domain. Platform domains
# only — tenant/workspace domains are served via SOCKETMAP_PORT + the backend
# directory (see docs/custom-domains.md).
LOCAL_DOMAINS=mailstr.app

# Networking
# ----------
# LMTP listener for the platform domain (Postfix routes to it).
LMTP_PORT=2400

# SMTP listener for workspace/tenant domains. mailcow's API-generated
# transport map is SMTP-only, so tenants route here instead of the LMTP port.
# UNUSED under the adopted path (unionmap + socketmap returns lmtp:), kept for
# deployments without the map override. Unset/0 disables it.
INBOUND_SMTP_PORT=0

# Outbound SMTP injection (into Postfix).
POSTFIX_HOST=postfix
POSTFIX_PORT=25

# Internal mail-send API (welcome mail, transactional, client send-wrap).
# Disabled unless SEND_API_KEY is set — an unauthenticated sender would let
# anyone originate mail as us. The send key is shared with the backend's
# BRIDGE_SEND_API_KEY. The port is NOT to be published to the host.
SEND_API_KEY=
SEND_API_PORT=2500

# Health / self-test watchdog. The self-test gift-wraps a ping to itself and
# restarts the process when it does not round-trip; /healthz reports the last
# result for orchestrators.
HEALTH_INTERVAL_MS=3600000
HEALTH_TIMEOUT_MS=30000
HEALTH_PORT=2510

# Relays
# ------
# Relays the bridge listens on and publishes to; bootstrap is the lookup pool
# used to resolve recipients. BRIDGE_RELAYS defaults to BOOTSTRAP_RELAYS.
BOOTSTRAP_RELAYS=wss://relay.formstr.app,wss://relay.primal.net,wss://nos.lol
BRIDGE_RELAYS=
# Always appended to a recipient's resolved DM relays when forwarding.
FIXED_RELAY=
RELAY_CACHE_MAX=1000
RELAY_CACHE_TTL_MS=3600000

# Size caps
# ---------
# Inbound message buffer cap. Keep at or below 8 MB with a 128 MB container:
# parsing peaks several times the message size.
MAIL_MAX_BYTES=8388608
# Largest kind-1059 wrap the relays carry; the raw-message ceiling is derived
# from it (~2.4x inflation).
RELAY_MAX_EVENT_BYTES=102400

# Attachments (receive path)
# --------------------------
BLOSSOM_SERVER_URL=https://nostr.download

# Tenant domains (path B — see docs/custom-domains.md)
# ---------------------------------------------------
# Postfix socketmap responder: Postfix's relay_domains / relay_recipient_maps
# / transport_maps consult this (via a mailcow extra.cf unionmap) so tenant
# activation is a backend DB row. Unset/0 disables it.
SOCKETMAP_PORT=24600
# Where the responder learns which tenant domains are active.
DOMAIN_DIRECTORY_URL=http://172.22.1.1:5000/api/domains/managed
DOMAIN_DIRECTORY_KEY=
DOMAIN_DIRECTORY_TTL_MS=300000
DOMAIN_DIRECTORY_NEGATIVE_TTL_MS=60000
DOMAIN_DIRECTORY_MAX_STALE_MS=60000
# Transport the socketmap returns for tenant domains.
TRANSPORT_NEXTHOP=nostr-bridge:2400

# Address resolution fallback for tenant domains (they have no public
# well-known of their own). Also used to authorize outbound From on them.
NIP05_RESOLVER_URL=http://172.22.1.1:5000
NIP05_RESOLVER_KEY=

# NIP-05 base URL override, for dev/staging where the platform well-known is
# not reachable at https://<domain>/.well-known/nostr.json.
NIP05_BASE_URL=
